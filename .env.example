# Server Port (Optional, default: 3000)
# PORT=3000

# SQLite Database Path (Optional, default: storage.db)
# Used to persist user stop preferences. In Docker, mount a volume to /data
# DATABASE_PATH=/data/storage.db

# Alexa Request Verification (default: true — secure by default)
# Set to 'false' ONLY for local testing to bypass signature/timestamp validation.
VERIFY_SIGNATURE=true

# Restrict requests to your skill id (recommended in production).
# ALEXA_SKILL_ID=amzn1.ask.skill.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# SIRI (Salamanca de Transportes) endpoint and timeout.
# Alexa gives the skill 8 s in total, keep the timeout well below that.
# SIRI_URL=http://95.63.53.46:8015/SIRI/SiriWS.asmx
# SIRI_TIMEOUT_MS=5500

# ---------------------------------------------------------------------------
# Echo Show widget
#
# The widget renders from a copy of the data on the device, so the server pushes updates to it
# with the Data Store REST API. That needs the skill's messaging credentials, which come from
# `ask smapi get-skill-credentials -s <skillId>` (or Developer Console -> Permissions ->
# "Alexa Skill Messaging"). Without them the refresh loop stays off and the rest of the skill
# is unaffected.
# ALEXA_CLIENT_ID=amzn1.application-oa2-client.xxxxxxxx
# ALEXA_CLIENT_SECRET=xxxxxxxx
# Alexa API region for the data store endpoint: EU (default), NA or FE.
# ALEXA_API_REGION=EU
# How often to push, in ms. Below ~20s you risk the 25 TPS write cap with many devices.
# WIDGET_REFRESH_MS=30000
# Hours (Europe/Madrid) the loop runs. Outside them there are no buses to report.
# WIDGET_ACTIVE_HOURS=6-24
# Read arrivals through the web app instead of calling SIRI directly, so the widget and the
# website share one SIRI call per stop. On the Oracle host both containers sit on the same
# docker network, so the service name is enough and Traefik/TLS is skipped. Unset = direct SIRI.
# WEB_API_URL=http://web:3000

# Developer Mode (Optional)
# Adds a prefix to Alexa APL titles for debugging purposes.
# IS_DEV=[DEV]
